# ============================================================
# 環境変数サンプル（このファイルをコピーして .env / .env.local を作成してください）
# 実際の値・APIキーは絶対にこのファイルやGitに含めないこと
# ============================================================

# --- Supabase（DB・認証） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側のみで使用（フロントには絶対に露出させない）
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI（文章生成） ---
# 設計書: バックエンド設計(3) 外部連携処理 / プラン別の月間生成数上限で管理
OPENAI_API_KEY=

# --- 天気API ---
# 設計書: バックエンド設計(4) 天気API連携・判定
OPENWEATHER_API_KEY=

# --- Stripe（決済・サブスク課金） ---
# 設計書: インフラ・運用設計(2) 決済
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SNS連携（テナントごとにOAuthトークンを別途DB保存する想定。
#     以下は開発・動作確認用のプレースホルダ） ---
INSTAGRAM_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=

# --- アプリ全体設定 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
